# Alterbrain secrets template.
#
# Copy this file to ".env.local" and fill in the values.
# NEVER commit ".env.local". It is ignored by git on purpose.
# Alterbrain never asks you to paste keys into the chat.

# Adzuna job search (optional, free). Used by "/jobs scan" for Dutch vacancies.
# Get a free key at https://developer.adzuna.com/ and paste the two values below.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
