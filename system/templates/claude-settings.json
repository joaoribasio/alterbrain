{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "disableSkillShellExecution": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(./**/*.abkey)",
      "Read(./**/vault-key-*.key)",
      "Read(./.git/git-crypt/**)",
      "Read(~/Documents/Alterbrain/**)"
    ],
    "ask": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward"
    ],
    "allow": [
      "Bash(node system/scripts/tasks.mjs *)",
      "Bash(node system/scripts/doctor.mjs *)",
      "Bash(node system/scripts/validate.mjs *)",
      "Bash(node system/scripts/proposals.mjs *)",
      "Bash(node system/scripts/ingest.mjs *)",
      "Bash(node system/scripts/ingest-pending.mjs *)",
      "Bash(node system/scripts/git-auto.mjs commit *)",
      "Bash(node system/scripts/git-auto.mjs status *)",
      "Bash(node system/scripts/date.mjs *)",
      "Bash(node system/scripts/slop-check.mjs *)",
      "Bash(node system/scripts/voice-stats.mjs *)",
      "Bash(node system/scripts/check-json.mjs *)",
      "Bash(node system/scripts/onboard-progress.mjs *)",
      "Bash(node system/scripts/onboard-seed.mjs *)",
      "Bash(node system/scripts/mcp-gen.mjs *)",
      "Bash(node system/scripts/qmd-prerender.mjs *)",
      "Bash(node system/scripts/update.mjs check *)",
      "Bash(node system/scripts/built.mjs list *)",
      "Bash(node system/scripts/built.mjs has *)",
      "Bash(node system/scripts/rate-guard.mjs status *)",
      "Bash(node system/scripts/jobs/ind-sponsors.mjs *)",
      "Bash(node system/scripts/jobs/adzuna.mjs *)",
      "Bash(node system/quarto/tools/render.mjs *)",
      "Bash(node system/quarto/tools/fonts.mjs *)",
      "Bash(node system/quarto/tools/pagecount.mjs *)",
      "Bash(node system/quarto/tools/explain.mjs *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "PowerShell(node system/scripts/tasks.mjs *)",
      "PowerShell(node system/scripts/doctor.mjs *)",
      "PowerShell(node system/scripts/validate.mjs *)",
      "PowerShell(node system/scripts/proposals.mjs *)",
      "PowerShell(node system/scripts/ingest.mjs *)",
      "PowerShell(node system/scripts/ingest-pending.mjs *)",
      "PowerShell(node system/scripts/git-auto.mjs commit *)",
      "PowerShell(node system/scripts/git-auto.mjs status *)",
      "PowerShell(node system/scripts/date.mjs *)",
      "PowerShell(node system/scripts/slop-check.mjs *)",
      "PowerShell(node system/scripts/voice-stats.mjs *)",
      "PowerShell(node system/scripts/check-json.mjs *)",
      "PowerShell(node system/scripts/onboard-progress.mjs *)",
      "PowerShell(node system/scripts/onboard-seed.mjs *)",
      "PowerShell(node system/scripts/mcp-gen.mjs *)",
      "PowerShell(node system/scripts/qmd-prerender.mjs *)",
      "PowerShell(node system/scripts/update.mjs check *)",
      "PowerShell(node system/scripts/built.mjs list *)",
      "PowerShell(node system/scripts/built.mjs has *)",
      "PowerShell(node system/scripts/rate-guard.mjs status *)",
      "PowerShell(node system/scripts/jobs/ind-sponsors.mjs *)",
      "PowerShell(node system/scripts/jobs/adzuna.mjs *)",
      "PowerShell(node system/quarto/tools/render.mjs *)",
      "PowerShell(node system/quarto/tools/fonts.mjs *)",
      "PowerShell(node system/quarto/tools/pagecount.mjs *)",
      "PowerShell(node system/quarto/tools/explain.mjs *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/session_start.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/protect_paths.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/block_secrets.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/block_dangerous_git.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/block_secrets.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/protect_paths.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/outbound_guard.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/outbound_guard.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/protect_paths.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/rate_guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/rate_guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/rate_guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/session_end.mjs", "--stop"],
            "timeout": 45
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/system/hooks/session_end.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
